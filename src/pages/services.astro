---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhaseCard from '../components/PhaseCard.astro';
import WhyUsCard from '../components/WhyUsCard.astro';
import { BOOKING_URL } from '../consts';

const phases = [
  {
    number: '01',
    title: 'Ladder Placement',
    timing: '1–2 weeks · Fixed fee',
    description: "Most teams believe they've already adopted AI and are further up the ladder than they are. We find out where you actually stand — Gated, Assisted, Parallel, or beyond — and what's blocking the next rung. 1:1 engineer interviews, a full SDLC audit, and an honest placement, not a vendor pitch.",
    bullets: [
      '1:1 engineer interviews across the org',
      'Full SDLC and toolchain audit',
      'Ladder placement — where you are, not where you think you are',
      'Devin vs. Shipwright fit assessment',
    ],
    outcome: 'A clear rung, a prioritized roadmap to the next one, and a straight answer on which path — Devin or Shipwright — fits your constraints.',
    delay: 0,
    circleClass: 'bg-electric-500/10',
    numberClass: 'text-electric-500',
    timingClass: 'text-electric-400',
    dotClass: 'bg-electric-500',
    labelClass: 'text-electric-400',
  },
  {
    number: '02',
    title: 'Guardrail Installation',
    timing: '4 weeks per project · Scoped per engagement',
    description: "Climbing from step 1 to step 2 isn't about more tokens — it's the guardrails: a self-verification loop you trust, automated review and security, worktree isolation so parallel agents don't collide. We build these directly into your systems, with engineers embedded on whichever tool you've chosen — Devin or Shipwright.",
    bullets: [
      'Self-verification loop: tests, build, lint, e2e',
      'Automated code review and security review',
      'Worktree isolation for parallel agents',
      'Security and access unblocking',
    ],
    outcome: 'The infrastructure the next rung actually requires — real guardrails your team runs on, not a configuration slide.',
    delay: 100,
    circleClass: 'bg-accent-cyan/10',
    numberClass: 'text-accent-cyan',
    timingClass: 'text-accent-cyan',
    dotClass: 'bg-accent-cyan',
    labelClass: 'text-accent-cyan',
  },
  {
    number: '03',
    title: 'Embedded Operation',
    timing: '4–6 weeks · Scoped per engagement',
    description: "Training decks and champion programs don't move a team up the ladder — we learned that the hard way. What works is running the actual orchestration alongside your engineers: multiple agents, your real backlog, our engineers pairing in the loop until parallel work is normal, not a workshop topic.",
    bullets: [
      'Embedded engineers, real backlog — not workshops',
      'Orchestrating agents in your review queue',
      'DORA metrics instrumented and visible',
      'Step 2 to step 3, done together, not taught',
    ],
    outcome: "Your team actually operating at the next rung — orchestrating agents daily, not attending a training that fades in a month.",
    delay: 200,
    circleClass: 'bg-accent-violet/10',
    numberClass: 'text-accent-violet',
    timingClass: 'text-accent-violet',
    dotClass: 'bg-accent-violet',
    labelClass: 'text-accent-violet',
  },
  {
    number: '04',
    title: 'Ongoing Velocity',
    timing: 'Pricing on request',
    description: "Teams stall mid-ladder without continuity. We stay engaged with quarterly rung check-ins, ad hoc support when new bottlenecks surface, and keep pushing until your team owns the climb completely.",
    bullets: [
      'Quarterly ladder reassessments',
      'Ad hoc blocker resolution',
      'Evolving guardrails as the tools change',
      'Sustained gains, permanently owned by your team',
    ],
    outcome: "Sustained velocity gains and permanent ownership by your team. We're the safety net until you don't need one.",
    delay: 300,
    circleClass: 'bg-electric-500/10',
    numberClass: 'text-electric-400',
    timingClass: 'text-electric-400',
    dotClass: 'bg-electric-400',
    labelClass: 'text-electric-400',
  },
];

const whyUsItems = [
  {
    lineClass: 'bg-electric-500',
    title: 'Senior founders, not junior consultants',
    description: "Dan and Dave do the work. You're not paying for a brand name and getting a rotating cast of associates. Two engineers with decades of combined depth — in every meeting, on every project.",
    delay: 0,
  },
  {
    lineClass: 'bg-accent-cyan',
    title: 'Phased, not open-ended',
    description: "Every engagement has a defined scope, timeline, and exit criteria. We're building toward your team's independence — not a perpetual billing relationship.",
    delay: 100,
  },
  {
    lineClass: 'bg-accent-violet',
    title: 'Measurable outcomes, not vague promises',
    description: "DORA metrics, cycle time, deployment frequency, and which rung you're actually on — we instrument what matters and track it. If you're not climbing, we adjust. No hand-waving.",
    delay: 200,
  },
  {
    lineClass: 'bg-electric-400',
    title: 'Small team + AI',
    description: "We practice what we preach. Two founders leveraging AI tools daily means startup velocity with enterprise quality. No overhead, no layers — just results.",
    delay: 300,
  },
];
---

<BaseLayout
  title="Services — App Vitals"
  description="A phased engagement model built around the AI adoption ladder: find your rung, install the guardrails, ship alongside your team, then hand off — for teams on Devin or Shipwright."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="glow-orb w-[400px] h-[400px] bg-electric-500/[0.05] top-[-10%] left-[15%] animate-glow-drift" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-20 md:pt-32 md:pb-24 relative z-10">
      <div class="max-w-3xl">
        <p class="font-mono text-[13px] text-electric-400 tracking-[0.25em] uppercase mb-6 opacity-0 animate-fade-in-up">
          Services
        </p>
        <h1 class="font-display text-[clamp(2.5rem,5vw,4.5rem)] font-bold leading-[1.05] tracking-[-0.03em] opacity-0 animate-fade-in-up-delay-1">
          A system, not<br />
          a <span class="gradient-text">rollout.</span>
        </h1>
        <p class="mt-8 text-[18px] text-white/45 max-w-xl leading-[1.7] opacity-0 animate-fade-in-up-delay-2">
          Installing Devin or Shipwright doesn't guarantee velocity — climbing the ladder does. Four phases, each one moving your team up a rung: find where you actually are, build the guardrails the next step requires, ship alongside your engineers until it's normal, then hand off.
        </p>
      </div>
    </div>
  </section>

  <!-- Phases -->
  <section class="relative">
    <div class="gradient-divider"></div>
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32">
      <div class="mb-16 reveal">
        <p class="font-mono text-[12px] text-electric-400 uppercase tracking-[0.3em] mb-4">The Model</p>
        <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] font-bold tracking-[-0.02em]">
          Installed isn't the same as faster.
        </h2>
      </div>
      <div class="space-y-8">
        {phases.map((phase) => <PhaseCard {...phase} />)}
      </div>
    </div>
  </section>

  <!-- How We're Different -->
  <section class="relative">
    <div class="gradient-divider"></div>
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32">
      <div class="mb-16 reveal">
        <p class="font-mono text-[12px] text-electric-400 uppercase tracking-[0.3em] mb-4">Why Us</p>
        <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] font-bold tracking-[-0.02em]">
          Not your typical AI consultancy.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-14">
        {whyUsItems.map((item) => <WhyUsCard {...item} />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 md:py-32">
    <div class="gradient-divider"></div>
    <div class="glow-orb w-[500px] h-[300px] bg-electric-500/[0.04] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 animate-glow-drift" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-6 pt-24 text-center relative z-10 reveal">
      <h2 class="font-display text-[clamp(1.75rem,4vw,3rem)] font-bold tracking-[-0.02em] leading-[1.15]">
        See which rung you're <span class="gradient-text">actually on.</span>
      </h2>
      <p class="mt-6 text-[17px] text-white/40 max-w-md mx-auto leading-[1.7]">
        30 minutes to find your place on the ladder, identify what's blocking the next step, and map the path up.
      </p>
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center mt-10 px-10 py-4 bg-white text-navy-950 rounded-full text-[16px] font-semibold tracking-wide transition-all duration-300 hover:shadow-[0_0_60px_rgba(59,130,246,0.3)] hover:scale-[1.02]"
      >
        Book a Discovery Call
        <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
