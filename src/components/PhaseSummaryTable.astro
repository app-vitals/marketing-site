---
interface Phase {
  number: string;
  title: string;
  timing: string;
  description: string;
  outcome: string;
  numberClass: string;
  labelClass: string;
}

interface Props {
  phases: Phase[];
}

const { phases } = Astro.props;
---

<div class="overflow-x-auto rounded-2xl border border-white/[0.06] bg-white/[0.02] mb-12 reveal">
  <table class="w-full min-w-[720px] border-collapse text-left">
    <thead>
      <tr class="border-b border-white/[0.06]">
        <th class="font-mono text-[11px] text-white/40 uppercase tracking-[0.2em] font-medium px-6 py-4">Phase</th>
        <th class="font-mono text-[11px] text-white/40 uppercase tracking-[0.2em] font-medium px-6 py-4">Duration</th>
        <th class="font-mono text-[11px] text-white/40 uppercase tracking-[0.2em] font-medium px-6 py-4">What Happens</th>
        <th class="font-mono text-[11px] text-white/40 uppercase tracking-[0.2em] font-medium px-6 py-4">You Get</th>
      </tr>
    </thead>
    <tbody>
      {phases.map((phase, i) => (
        <tr class={i < phases.length - 1 ? 'border-b border-white/[0.06]' : ''}>
          <td class="px-6 py-5 align-top whitespace-nowrap">
            <div class="flex items-center gap-3">
              <span class={`font-mono text-[12px] ${phase.numberClass} font-bold`}>{phase.number}</span>
              <span class="font-display text-[15px] font-semibold tracking-tight">{phase.title}</span>
            </div>
          </td>
          <td class={`px-6 py-5 align-top font-mono text-[12px] ${phase.labelClass} tracking-[0.05em] whitespace-nowrap`}>
            {phase.timing}
          </td>
          <td class="px-6 py-5 align-top text-[14px] text-white/45 leading-[1.6] min-w-[240px]">
            <p class="line-clamp-2">{phase.description}</p>
          </td>
          <td class="px-6 py-5 align-top text-[14px] text-white/45 leading-[1.6] min-w-[240px]">
            <p class="line-clamp-2">{phase.outcome}</p>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
